# MDFourier-DOS build script (Open Watcom / wmake)
#
# 16-bit real mode DOS executable, medium model, no DOS extender
#
# Usage:
#   wmake            build mdf.exe (release)
#   wmake DEBUG=1    build with debug info (after wmake clean)
#   wmake clean      remove build output

BIN  = mdf.exe
CC = wcc

# Objects depend on headers
HDRS = include\carddrv.h include\dsp.h include\env.h include\irq.h include\kbd.h &
       include\mixer.h include\pcmdrv.h include\wss.h include\sax.h include\host.h include\caps.h include\cms.h include\cmsblk.h include\sb2seq.h include\seq.h include\fmblk.h include\pcmblk.h &
       include\mdf.h include\opl.h include\opltone.h include\pcm.h include\pit.h &
       include\sweep.h include\vsync.h

OBJS = build\main.obj build\dsp.obj build\pcm.obj build\ess.obj build\wss.obj build\sax.obj build\host.obj build\cms.obj build\cmsblk.obj build\sb2seq.obj build\seq.obj build\fmblk.obj build\pcmblk.obj build\env.obj build\kbd.obj build\mixer.obj build\pit.obj &
       build\vsync.obj build\opltone.obj build\mdf.obj &
       build\opl.obj
# -q            quiet
# -bt=dos       target DOS
# -mm           medium memory model (far code, 64K data)
# -0            8086/8088 instructions only
# -fpi          uses an 8087 if present, software emulation if not
# -d2           full debug info
# -i=include    include header files
CFLAGS = -q -bt=dos -mm -0 -fpi -i=include

# wmake DEBUG=1 adds full debug info (-d2)
!ifdef DEBUG
CFLAGS += -d2
!endif

all: $(BIN) .SYMBOLIC

dirs: .SYMBOLIC
	@if not exist build\nul mkdir build

# Linking wlink directly
$(BIN): dirs $(OBJS)
	%write build\link.lnk FILE { $(OBJS) }
	wlink @build\link.lnk name mdf.exe system dos option stack=8192

build\main.obj: src\main.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\main.c

build\cms.obj: src\cms.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\cms.c

build\cmsblk.obj: src\cmsblk.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\cmsblk.c

build\sb2seq.obj: src\sb2seq.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\sb2seq.c

build\seq.obj: src\seq.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\seq.c

build\fmblk.obj: src\fmblk.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\fmblk.c

build\pcmblk.obj: src\pcmblk.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\pcmblk.c

build\dsp.obj: src\dsp.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\dsp.c

build\pcm.obj: src\pcm.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\pcm.c

build\ess.obj: src\ess.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\ess.c

build\wss.obj: src\wss.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\wss.c

build\sax.obj: src\sax.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\sax.c

build\host.obj: src\host.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\host.c

build\env.obj: src\env.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\env.c

build\kbd.obj: src\kbd.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\kbd.c

build\mixer.obj: src\mixer.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\mixer.c

build\pit.obj: src\pit.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\pit.c

build\vsync.obj: src\vsync.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\vsync.c

build\opltone.obj: src\opltone.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\opltone.c

build\mdf.obj: src\mdf.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\mdf.c

build\opl.obj: src\opl.c $(HDRS)
	$(CC) $(CFLAGS) -fo=$@ src\opl.c

clean: .SYMBOLIC
	@if exist build\*.obj del build\*.obj
	@if exist build\*.lnk del build\*.lnk
	@if exist mdf.exe del mdf.exe
